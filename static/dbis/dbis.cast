[92.737459, "o", " et Musée Voltaire ; Oxford : Voltaire Foundation. Enthalten sind die Bände 8, 10, 14, 15,   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m17, 31B, 33, 35-36, 50, 62, 63A, 64, 69 vollständig. Die vor der Neugestaltung der Edition im Jahre 1984 publizierten Bände 2, 7, 48, 53-55, 58-82     \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128msind dem Text nach enthalten; die editorischen Beigaben werden der Ausgabe erst nach Neuerscheinen der Bände zugefügt werden. Die Oxford-Edition wird  \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mnach Abschluß die erste kritische vollständige Ausgabe von Voltaires Werk                                                                              \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128msein.\",\"subjects\":[{\"id\":\"31\",\"name\":\"Philosophie\"},{\"id\":\"36\",\"name\":\"Romanistik\"}],\"database_types\":[\"Volltextdatenbank\"],\"keywords\":[\"Voltaire\",\"We \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mrke\"],\"weitere_informationen\":{\"Alternative Titel\":[\"/ Voltaire Foundation\"],\"ISBN/ISSN\":[\"0-85964-300-X\"]},\"fetched_at\":\"2026-05-05T13:33:25Z\"}\u001b[39m       \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m{\"resource_id\":\"100000\",\"url\":\"https://dbis.uni-regensburg.de/UBL/resources/100000\",\"title\":\"EconLit with Full Text (via EBSCO Host) (Dublette zu ID   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m6926)\",\"availability\":\"red\",\"description\":\"Enthält wirtschaftswissenschaftliche Veröffentlichungen ab 1969 sowie Volltexte von mehr als 480            \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mFachzeitschriften, einschließlich der Zeitschriften der American Economic Association (American Economic Review, Journal of Economic Literature and    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mJournal of Economic Perspectives) ohne Embargo. Außerdem werden viele nicht-englische Volltexte aus den Gebieten Wirtschaft und Finanzwesen            \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mnachgewiesen. EconLit with Full Text umfasst u.a. die Fachgebiete Volkswirtschaft, Wirtschaftsgeographie, Wirtschaftsgeschichte, Wirtschaftspolitik,   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mWirtschaftstheorie sowie                                                                                                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mFinanzwesen.\",\"subjects\":[{\"id\":\"43\",\"name\":\"Wirtschaftswissenschaften\"}],\"database_types\":[\"Fachbibliographie\",\"Volltextdatenbank\"],\"keywords\":[\"Wirt \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mschaftswissenschaften\",\"Volkswirtschaft\",\"Bibliografie\"],\"fetched_at\":\"2026-05-05T13:33:29Z\"}\u001b[39m                                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128m{\"resource_id\":\"100002\",\"url\":\"https://dbis.uni-regensburg.de/UBL/resources/100002\",\"title\":\"Eidgenössischer                                           \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;40;50;40m \u001b[38;2;128;128;128mStaatskalender\",\"availability\":\"green\",\"description\":\"Der Eidgenössische Staatskalender beinhaltet Strukturinformationen und Referenzdaten der         \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u00