[16.362738, "o", "itorische \bn Beigaben werden der Ausgabe erst nach Neuerscheinen der Bände zugefügt werden. Die Oxford-Edition wird nach Abschluß die erste kritische vollständige  \bAusgabe von Voltaires Werk sein.\",\r\n  \"subjects\": [\r\n    {\r\n      \"id\": \"31\",\r\n      \"name\": \"Philosophie\"\r\n    },\r\n    {\r\n      \"id\": \"36\",\r\n      \"name\": \"Romanistik\"\r\n    }\r\n  ],\r\n  \"database_types\": [\r\n    \"Volltextdatenbank\"\r\n  ],\r\n  \"keywords\": [\r\n    \"Voltaire\",\r\n    \"Werke\"\r\n:\u001b[K"]
