[16.508412, "o", "  ],\r\n  \"weitere_informationen\": {\r\n    \"Alternative Titel\": [\r\n      \"/ Voltaire Foundation\"\r\n    ],\r\n    \"ISBN/ISSN\": [\r\n      \"0-85964-300-X\"\r\n    ]\r\n  },\r\n  \"fetched_at\": \"2026-05-05T13:33:25Z\"\r\n}\r\n{\r\n  \"resource_id\": \"100000\",\r\n  \"url\": \"https://dbis.uni-regensburg.de/UBL/resources/100000\",\r\n  \"title\": \"EconLit with Full Text (via EBSCO Host) (Dublette zu ID 6926)\",\r\n  \"availability\": \"red\",\r\n  \"description\": \"Enthält wirtschaftswissenschaftliche Veröffentlichungen ab 1969 sowie Volltexte von mehr als 480 Fachzeitschriften, einschließlich der \b Zeitschriften der American Economic Association (American Economic Review, Journal of Economic Literature and Journal of Economic Perspectives) ohne Em \bbargo. Außerdem werden viele nicht-englische Volltexte aus den Gebieten Wirtschaft und Finanzwesen nachgewiesen. EconLit with Full Text umfasst u.a. die \b Fachgebiete Volkswirtschaft, Wirtschaftsgeographie, Wirtschaftsgeschichte, Wirtschaftspolitik, Wirtschaftstheorie sowie Finanzwesen.\",\r\n"]
[16.508627, "o", "  \"subjects\": [\r\n    {\r\n      \"id\": \"43\",\r\n      \"name\": \"Wirtschaftswissenschaften\"\r\n    }\r\n  ],\r\n  \"database_types\": [\r\n    \"Fachbibliographie\",\r\n    \"Volltextdatenbank\"\r\n  ],\r\n  \"keywords\": [\r\n    \"Wirtschaftswissenschaften\",\r\n    \"Volkswirtschaft\",\r\n    \"Bibliografie\"\r\n  ],\r\n  \"fetched_at\": \"2026-05-05T13:33:29Z\"\r\n}\r\n{\r\n  \"resource_id\": \"100002\",\r\n  \"url\": \"https://dbis.uni-regensburg.de/UBL/resources/100002\",\r\n  \"title\": \"Eidgenössischer Staatskalender\",\r\n  \"availability\": \"green\",\r\n  \"description\": \"Der Eidgenössische Staatskalender beinhaltet Strukturinformationen und Referenzdaten der gesamten Bundesverwaltung, d.h. der Bundeskan \bzlei und aller Departemente, der Bundesversammlung, der Gerichte, der Schweizerischen Nationalbank sowie der SUVA, POST und SBB. Der Staatskalender ist  \bdreisprachig aufgebaut und die darin enthaltenen Daten werden direkt durch die entsprechenden Verwaltungseinheiten gepflegt.\",\r\n  \"access_groups\": [\r\n    {\r\n:\u001b[K"]
