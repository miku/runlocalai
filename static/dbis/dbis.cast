[90.682202, "o", "\u001b[?2026h\u001b[5A\r\u001b[2K\u001b]133;A\u0007\u001b[48;2;52;53;65m                                                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;52;53;65m \u001b[39myou are library information system and you know a lot about subject databases; all the subject database you know about are listed in @data/dbis.jsonl  \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;52;53;65m including subject areas, url, etc; drop now into library information system mode and\u001b[39m                                                                   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;52;53;65m \u001b[39mtreat every successive prompt as a user request and respond with a list of relevant databases (include the url in result, if available) for the users  \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[48;2;52;53;65m request; you can write the result to a file following a pattern like ANSWER-[QUERY-SLUG].md                                                            \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b]133;B\u0007\u001b]133;C\u0007\u001b[48;2;52;53;65m                                                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;138;190;183m⠋\u001b[39m \u001b[38;2;128;128;128mWorking...\u001b[39m                                                                                                                                           \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b[38;2;80;80;80m─\u001b[39m\u001b[38;2;80;80;80m─\u001b[39m\u001b[38;2;80;80;80m─\u001b[39m\u001b[38;2;80;80;80m─\u001b[39m\u001b[38;2;80;80;80m─\u001b[39m\u001b[38;2;80;80;80m─\u001